# Copy to .env and fill in. Never commit the real file.

# Web login. Leave empty to use the first-run setup page in the browser.
# Do not use change-me / 123456. At least 8 characters.
ACCESS_PASSWORD=

# Bind
HOST=0.0.0.0
PORT=8787
TZ=Asia/Shanghai

# DeepSeek / OpenAI-compatible / 中转站
# Base URL should be the root (…/v1) or the full …/chat/completions path.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# GitHub Stars (public list works without a token)
GITHUB_USERNAME=
GITHUB_TOKEN=

# WeCom app message. Leave empty to skip notify.
WECOM_CORPID=
WECOM_SECRET=
WECOM_AGENTID=
WECOM_TOUSER=@all

# Optional web search APIs. If empty, DuckDuckGo HTML is the fallback.
BRAVE_API_KEY=
TAVILY_API_KEY=

# Public URL used in WeCom links, e.g. http://203.0.113.10:8787
PUBLIC_BASE_URL=

# Optional UI-art generation. Not used by the daily job.
IMAGE_API_BASE_URL=
IMAGE_API_KEY_FILE=
IMAGE_API_MODEL=

# SQLite path. Default: ./data/yandu.db
DATABASE_PATH=
